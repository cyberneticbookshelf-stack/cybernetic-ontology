# Calibre creators who also appear as persons in other books' indexes (candidate name matches)
PREFIX cyb: <https://w3id.org/cybernetic-bookshelf/ontology#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?name (COUNT(DISTINCT ?book) AS ?indexedIn) WHERE {
  ?m a cyb:NameMatch ; cyb:matchesCreator ?c ; cyb:matchesPerson ?p .
  ?c foaf:name ?name .
  ?p cyb:hasLabelSource ?term .
  ?entry cyb:normalisesTo ?term ; cyb:inIndexOf ?book .
} GROUP BY ?name ORDER BY DESC(?indexedIn) LIMIT 15
