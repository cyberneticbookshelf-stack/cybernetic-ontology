# Persons most often indexed, by number of books (provisional classifications, any confidence)
PREFIX cyb: <https://w3id.org/cybernetic-bookshelf/ontology#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?label (COUNT(DISTINCT ?book) AS ?books) WHERE {
  ?term cyb:possiblyDenotes ?p .  ?p a cyb:Person ; rdfs:label ?label .
  ?entry cyb:normalisesTo ?term ; cyb:inIndexOf ?book .
} GROUP BY ?label ORDER BY DESC(?books) LIMIT 15
