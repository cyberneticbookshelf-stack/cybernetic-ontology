# Index extraction status by publication decade (index quality as covariate)
PREFIX cyb: <https://w3id.org/cybernetic-bookshelf/ontology#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?decade ?status (COUNT(?book) AS ?n) WHERE {
  ?book cyb:hasIndexStatus/skos:prefLabel ?status ; dcterms:issued ?y .
  BIND (FLOOR(xsd:integer(STR(?y)) / 10) * 10 AS ?decade)
} GROUP BY ?decade ?status ORDER BY ?decade ?status
