# Classifications below the entity-network threshold (0.75), by method and kind - review candidates
PREFIX cyb: <https://w3id.org/cybernetic-bookshelf/ontology#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?method ?kind (COUNT(*) AS ?n) WHERE {
  ?c a cyb:EntityClassification ; cyb:confidence ?conf ; cyb:assignedKind/skos:prefLabel ?kind ;
     prov:wasAttributedTo ?m .
  ?m rdfs:label|foaf:name ?method .
  FILTER (?conf < 0.75)
} GROUP BY ?method ?kind ORDER BY DESC(?n)
